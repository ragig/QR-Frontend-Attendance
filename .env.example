# Where axios sends requests.
#   /api                         -> uses the Vite dev proxy (recommended in development)
#   https://your-django-host/api -> direct calls (Django must allow CORS for this frontend)
VITE_API_URL=/api

# Django address used by the Vite dev proxy (development only)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Address a PHONE can reach this frontend on. Used inside the personal QR code.
# Use your computer's LAN IP, not localhost, e.g. http://192.168.1.10:5173
# VITE_PUBLIC_APP_URL=http://192.168.1.10:5173
